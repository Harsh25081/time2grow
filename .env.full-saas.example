# time2grow full SaaS environment template
# Copy safe frontend values to apps/web/.env.local for local development.
# Set server-only values in Supabase secrets, hosting secrets, or your secret manager.
# Do not commit real .env files or real secrets.

# App
VITE_APP_ENV=local
VITE_APP_NAME=time2grow
VITE_APP_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=support@time2grow.example
APP_ORIGIN=http://localhost:5173
SOCIAL_OAUTH_REDIRECT_URI=

# Supabase public frontend values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server-only values
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# OpenAI server-only values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Image generator for Poster Studio "Generate poster" (hybrid AI art).
# IMAGE_PROVIDER selects the adapter (currently: openai). Add gemini/nano-banana/deepseek adapters in ai-handler as needed.
IMAGE_PROVIDER=openai
# Must be a real image model on your OpenAI account (e.g. gpt-image-1 or gpt-image-2).
# gpt-image-2 defaults to size/quality "auto" automatically; gpt-image-1 uses per-request values.
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional hard overrides for image size/quality (e.g. set both to "auto" for gpt-image-2 tuning).
# OPENAI_IMAGE_SIZE=auto
# OPENAI_IMAGE_QUALITY=auto

# Per-purpose text model routing. Each content text call (generation, scoring, visual art-prompt)
# picks its provider from AI_PROVIDER_<PURPOSE>, falling back to AI_PROVIDER, defaulting to openai.
# DeepSeek is OpenAI-compatible; set DEEPSEEK_API_KEY and route only the calls you have validated.
# Recommended: keep generation on OpenAI (proven Telugu/Hindi/Kannada quality) and try DeepSeek on
# 'scoring' or 'visual' first. Leave these unset to keep everything on OpenAI.
# AI_PROVIDER=openai
# AI_PROVIDER_GENERATION=openai
# AI_PROVIDER_SCORING=deepseek
# AI_PROVIDER_VISUAL=deepseek
# Optional per-purpose OpenAI model overrides (else OPENAI_MODEL is used).
# OPENAI_MODEL_SCORING=gpt-4o-mini
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Use a real model id from your DeepSeek dashboard (e.g. deepseek-chat). Set per purpose if desired.
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL_SCORING=deepseek-chat
# DEEPSEEK_MODEL_VISUAL=deepseek-chat

AI_DAILY_ACCOUNT_CAP=100
AI_DAILY_ORG_CAP=40
AI_MONTHLY_SPEND_CAP_INR=5000
AI_WEBSITE_MAX_BYTES=512000
AI_STYLESHEET_MAX_BYTES=150000
AI_WEBSITE_MAX_TEXT_CHARS=6000
AI_WEBSITE_FETCH_TIMEOUT_MS=10000
AI_LOGO_MAX_BYTES=2000000
# Long Telugu scripts and blog posts run past 25s. Keep this at 60s or higher.
AI_OPENAI_TIMEOUT_MS=60000
# Virality gate: only content that self-scores at or above AI_VIRALITY_MIN is delivered as "passed".
# Below it, the model revises up to AI_VIRALITY_MAX_REVISIONS times; the best attempt is always
# returned (with its honest score) even if it never clears the bar. Higher min / more revisions =
# better floor but more AI calls and latency. Lower AI_VIRALITY_MAX_REVISIONS if long scripts get slow.
AI_VIRALITY_MIN=75
AI_VIRALITY_MAX_REVISIONS=2
# The scoring call also writes revisions, so it gets more time than a pure grading call.
AI_SCORING_TIMEOUT_MS=40000
AI_OPENAI_IMAGE_TIMEOUT_MS=90000

# Billing
VITE_BILLING_PROVIDER=razorpay
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email and notifications
RESEND_API_KEY=
SYSTEM_FROM_EMAIL=no-reply@time2grow.example
SUPPORT_TO_EMAIL=support@time2grow.example

# Observability
SENTRY_DSN=
UPTIME_WEBHOOK_URL=
LOG_LEVEL=info

# Security and admin
INTERNAL_ADMIN_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=
AUDIT_LOG_RETENTION_DAYS=365

# Storage and exports
DATA_EXPORT_BUCKET=data-exports

# Meta: Facebook Pages + Instagram Business
META_CLIENT_ID=
META_CLIENT_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
FACEBOOK_REQUIRED_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,business_management,instagram_basic,instagram_content_publish

# Google: YouTube + Google Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REQUIRED_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_CATEGORY_ID=22
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REQUIRED_SCOPES=https://www.googleapis.com/auth/adwords

# WhatsApp Business Platform
WHATSAPP_CLIENT_ID=
WHATSAPP_CLIENT_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202606
LINKEDIN_WEBHOOK_SECRET=
LINKEDIN_REQUIRED_SCOPES=w_member_social,w_organization_social,rw_organization_admin

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_REQUIRED_SCOPES=chat:write,channels:read,groups:read

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=